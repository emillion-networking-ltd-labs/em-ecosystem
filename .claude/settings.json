{
  "env": {
    "CLAUDE_CODE_DISABLE_AUTO_MEMORY": "1"
  },
  "outputStyle": "Concise",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|NotebookEdit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "/tmp/keel203/bin/python3 -m emkeel.guard.hooks.pre_tool_use"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/tmp/keel203/bin/python3 -m emkeel.guard.hooks.session_start"
          }
        ]
      }
    ]
  }
}
