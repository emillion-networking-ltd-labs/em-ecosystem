{
  "name": "@em-ecosystem/root",
  "version": "0.0.1",
  "private": true,
  "description": "EM Ecosystem monorepo root — git hooks and workspace tooling",
  "scripts": {
    "prepare": "husky",
    "lint:api": "cd nexacore-api && npx eslint \"src/**/*.ts\" --no-fix",
    "lint:dashboard": "cd nexacore-dashboard && npm run lint",
    "test:api": "cd nexacore-api && npm test",
    "test:dashboard": "cd nexacore-dashboard && npm test",
    "dup:check": "jscpd --config .jscpd.json",
    "lic:check": "node scripts/check-licenses.mjs",
    "lic:check:ds": "node scripts/check-licenses.mjs design-system --allow axe-core --allow lightningcss --allow lightningcss-linux-x64-gnu --allow lightningcss-linux-x64-musl --allow @img/sharp-libvips-linux-x64 --allow @img/sharp-libvips-linuxmusl-x64 --allow @img/sharp-wasm32",
    "sb:build": "cd design-system && npm run build-storybook",
    "sb:coverage": "cd design-system && npm run coverage",
    "sb:test": "cd design-system && npm run test-storybook"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "jscpd": "^4.0.9",
    "lint-staged": "^15.4.3"
  },
  "lint-staged": {
    "nexacore-api/src/**/*.ts": "npx prettier --check --config nexacore-api/.prettierrc",
    "nexacore-dashboard/src/**/*.{ts,tsx}": "npx prettier --check"
  },
  "overrides": {
    "yaml": ">=2.8.3"
  }
}
