DATABASE_URL="postgresql://user:password@localhost:5432/em_ecosystem?schema=public"
JWT_SECRET="your-jwt-secret-min-32-characters-long"
JWT_ACCESS_EXPIRATION="15m"
JWT_REFRESH_EXPIRATION="7d"
PORT=3000
FRONTEND_URL="http://localhost:3001"

# Swagger UI (enabled by default in non-production; set to 'true' to enable in production)
SWAGGER_ENABLED=""

# Google OAuth
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_CALLBACK_URL="http://localhost:3000/auth/google/callback"

# GitHub OAuth
GITHUB_CLIENT_ID="your-github-client-id"
GITHUB_CLIENT_SECRET="your-github-client-secret"
GITHUB_CALLBACK_URL="http://localhost:3000/auth/github/callback"

# OAuth Security
OAUTH_ALLOWED_REDIRECT_URLS="http://localhost:3001"

# Redis
REDIS_HOST="localhost"
REDIS_PORT="6379"
REDIS_PASSWORD=""
REDIS_DB="0"
REDIS_KEY_PREFIX="nexacore:"

# Redis TLS (required for cloud-managed Redis: AWS ElastiCache, Azure Cache)
REDIS_TLS_ENABLED="false"
REDIS_TLS_REJECT_UNAUTHORIZED="true"

# WebAuthn / Passkeys
WEBAUTHN_RP_ID="localhost"
WEBAUTHN_RP_NAME="EM NexaCore"
WEBAUTHN_ORIGIN="http://localhost:3001"

# Cloudflare Turnstile (CAPTCHA)
TURNSTILE_SECRET_KEY="1x0000000000000000000000000000000AA"

# Suspicious Login Detection
BRUTE_FORCE_WINDOW_MINUTES="15"
BRUTE_FORCE_THRESHOLD="10"
CREDENTIAL_STUFFING_THRESHOLD="20"
UNUSUAL_HOURS_SAMPLE_SIZE="20"
UNUSUAL_HOURS_STDDEV_THRESHOLD="3"
UNUSUAL_HOURS_MIN_LOGINS="5"
