# ──────────────────────────────────────────────────────────────────
# EM NexaCore API — Environment Variables
# Copy this file to .env and fill in your values.
# Variables marked REQUIRED have no safe default and must be set.
# ──────────────────────────────────────────────────────────────────

# ─── Environment & App ───────────────────────────────────────────
NODE_ENV="development"
PORT=3000
FRONTEND_URL="http://localhost:3001"

# Swagger UI (enabled by default in non-production; set to 'true' to enable in production)
SWAGGER_ENABLED=""

# ─── Database ────────────────────────────────────────────────────
# REQUIRED — sslmode=require is mandatory in production (OWASP ASVS V8.3.7)
DATABASE_URL="postgresql://user:password@localhost:5432/em_ecosystem?schema=public&sslmode=require"

# ─── JWT ─────────────────────────────────────────────────────────
# REQUIRED — min 32 characters
JWT_SECRET="your-jwt-secret-min-32-characters-long"
JWT_ACCESS_EXPIRATION="15m"
JWT_REFRESH_EXPIRATION="12h"

# ─── Sessions ────────────────────────────────────────────────────
SESSION_IDLE_TIMEOUT_HOURS="0.5"
MAX_CONCURRENT_SESSIONS="5"
TRUSTED_DEVICE_TTL_DAYS="30"

# ─── MFA (Multi-Factor Authentication) ──────────────────────────
MFA_APP_NAME="EM NexaCore"
# REQUIRED in production — min 32 characters, must differ from dev default
MFA_ENCRYPTION_KEY="your-mfa-encryption-key-min-32-characters"

# ─── WebAuthn / Passkeys ────────────────────────────────────────
WEBAUTHN_RP_ID="localhost"
WEBAUTHN_RP_NAME="EM NexaCore"
WEBAUTHN_ORIGIN="http://localhost:3001"

# ─── Google OAuth ────────────────────────────────────────────────
# REQUIRED in production
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_CALLBACK_URL="http://localhost:3000/auth/google/callback"

# ─── GitHub OAuth ────────────────────────────────────────────────
# REQUIRED in production
GITHUB_CLIENT_ID="your-github-client-id"
GITHUB_CLIENT_SECRET="your-github-client-secret"
GITHUB_CALLBACK_URL="http://localhost:3000/auth/github/callback"

# ─── OAuth Security ─────────────────────────────────────────────
OAUTH_ALLOWED_REDIRECT_URLS="http://localhost:3001"

# ─── CSRF Protection ────────────────────────────────────────────
# REQUIRED in production — min 32 characters, must differ from dev default
CSRF_SECRET="your-csrf-secret-min-32-characters-long"

# ─── CORS ────────────────────────────────────────────────────────
# Comma-separated origins. Falls back to FRONTEND_URL if not set.
CORS_ALLOWED_ORIGINS=""

# ─── Redis ───────────────────────────────────────────────────────
REDIS_HOST="localhost"
REDIS_PORT="6379"
REDIS_PASSWORD=""
REDIS_DB="0"
REDIS_KEY_PREFIX="nexacore:"

# Redis TLS (required for cloud-managed Redis: AWS ElastiCache, Azure Cache)
REDIS_TLS_ENABLED="false"
REDIS_TLS_REJECT_UNAUTHORIZED="true"

# ─── SMTP / Email ───────────────────────────────────────────────
SMTP_HOST="localhost"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM='"EM NexaCore" <noreply@emillionnetworking.com>'

# ─── Cloudflare Turnstile (CAPTCHA) ─────────────────────────────
# Test key below always passes — replace with real key in production
TURNSTILE_SECRET_KEY="1x0000000000000000000000000000000AA"

# ─── Geolocation & Travel Detection ─────────────────────────────
MAXMIND_DB_PATH="./data/GeoLite2-City.mmdb"
GEOLOCATION_CACHE_MAX_SIZE="10000"
GEOLOCATION_CACHE_TTL_HOURS="24"
IMPOSSIBLE_TRAVEL_SPEED_KMH="900"
IMPOSSIBLE_TRAVEL_MIN_DISTANCE_KM="100"
# Options: alert_only, challenge, block
IMPOSSIBLE_TRAVEL_ALERT_STRATEGY="alert_only"

# ─── Suspicious Login Detection ─────────────────────────────────
BRUTE_FORCE_WINDOW_MINUTES="15"
BRUTE_FORCE_THRESHOLD="10"
CREDENTIAL_STUFFING_THRESHOLD="20"
UNUSUAL_HOURS_SAMPLE_SIZE="20"
UNUSUAL_HOURS_STDDEV_THRESHOLD="3"

# ─── Phase 8 Shadow Decisions (SCRUM-460) ───────────────────────
# Output JSONL. Append-only. Aligned with consolidation wrappers.
SHADOW_LOG_PATH="/home/em-admin/projects/em-ecosystem/logs/shadow-decisions.jsonl"

# Master enforcement mode. Phase 8 default = shadow (observe only).
# Flipping to active requires §15-compliant ticket + 24h shadow monitoring.
ONLINE_ENFORCEMENT_MODE="shadow"

# Path to the per-cap flags YAML (relative to nexacore-api cwd).
ONLINE_FLAGS_PATH="./online-enforcement-flags.yml"
