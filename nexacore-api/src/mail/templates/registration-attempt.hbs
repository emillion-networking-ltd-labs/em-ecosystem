<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Registration attempt on your account</title>
</head>
<body style="margin: 0; padding: 0; background-color: #f4f4f5; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;">
  <table role="presentation" cellpadding="0" cellspacing="0" width="100%" style="max-width: 600px; margin: 0 auto; padding: 40px 20px;">
    <tr>
      <td>
        <!-- Header -->
        <table role="presentation" cellpadding="0" cellspacing="0" width="100%" style="margin-bottom: 24px;">
          <tr>
            <td style="font-size: 24px; font-weight: 700; color: #09090b; padding-bottom: 8px;">
              EM NexaCore
            </td>
          </tr>
        </table>

        <!-- Card -->
        <table role="presentation" cellpadding="0" cellspacing="0" width="100%" style="background-color: #ffffff; border: 1px solid #e4e4e7; border-radius: 12px; padding: 32px;">
          <tr>
            <td>
              <h1 style="margin: 0 0 8px 0; font-size: 20px; font-weight: 600; color: #09090b;">
                Registration attempt detected
              </h1>
              <p style="margin: 0 0 24px 0; font-size: 14px; line-height: 1.6; color: #71717a;">
                Hi {{name}}, someone tried to create a new EM NexaCore account using your email address on {{attemptedAt}}.
              </p>

              <p style="margin: 0 0 16px 0; font-size: 14px; line-height: 1.6; color: #71717a;">
                Since you already have an account, no new account was created. You can sign in with your existing credentials or reset your password if needed.
              </p>

              <p style="margin: 0 0 16px 0; font-size: 13px; line-height: 1.6; color: #ef4444; font-weight: 500;">
                If you did not attempt this registration, someone may have your email address. No action is required, but you may want to ensure your password is strong.
              </p>

              <!-- CTA Button -->
              <table role="presentation" cellpadding="0" cellspacing="0" style="margin-bottom: 16px;">
                <tr>
                  <td style="border-radius: 8px; background-color: #09090b;">
                    <a href="{{frontendUrl}}/login" target="_blank" style="display: inline-block; padding: 12px 32px; font-size: 14px; font-weight: 500; color: #ffffff; text-decoration: none; border-radius: 8px;">
                      Sign in to EM NexaCore
                    </a>
                  </td>
                </tr>
              </table>

              <p style="margin: 0; font-size: 13px; color: #71717a;">
                <a href="{{frontendUrl}}/forgot-password" target="_blank" style="color: #3b82f6; text-decoration: none;">Reset your password</a> if you suspect your account may be compromised.
              </p>
            </td>
          </tr>
        </table>

        <!-- Footer -->
        <table role="presentation" cellpadding="0" cellspacing="0" width="100%" style="margin-top: 24px;">
          <tr>
            <td style="font-size: 12px; color: #a1a1aa; text-align: center;">
              &copy; {{currentYear}} EMillion Networking LTD. All rights reserved.
            </td>
          </tr>
        </table>
      </td>
    </tr>
  </table>
</body>
</html>
