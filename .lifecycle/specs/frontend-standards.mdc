### Navigation Patterns
- Use **Next.js file-system routing** — pages defined by directory structure in `src/app/`
- Use **Next.js `Link` component** for client-side navigation
- **Route guards** implemented as wrapper components (`ProtectedRoute`, `AdminRoute`)
- Use **redirect** from `next/navigation` for programmatic navigation

```typescript
import Link from 'next/link';
import { redirect } from 'next/navigation';

// Declarative navigation
<Link href="/profile" className="text-accent hover:underline">
  Profile
</Link>

// Guard component pattern
export default function ProtectedRoute({ children }: { children: React.ReactNode }) {
  const { user, isLoading } = useAuth();

  if (isLoading) return <Spinner />;
  if (!user) { redirect('/login'); return null; }

  return <>{children}</>;
}

// Project-scoped guard for pages under /projects/[id]/
export default function ProjectMemberRoute({ children }: { children: React.ReactNode }) {
  const { user } = useAuth();
  const { currentProject, isLoading } = useProject();

  if (isLoading) return <Spinner />;
  if (!user) { redirect('/login'); return null; }
  if (!currentProject) { redirect('/projects'); return null; }

  return <>{children}</>;
}
```

