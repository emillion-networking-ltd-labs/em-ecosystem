# ──────────────────────────────────────────────────────────────────
# EM NexaCore Dashboard — Environment Variables
# Copy this file to .env.local and fill in your values.
# Only NEXT_PUBLIC_* vars exist here; they are exposed to the browser —
# NEVER put secrets in this file.
# ──────────────────────────────────────────────────────────────────

# ─── Backend API ─────────────────────────────────────────────────
# Base URL of the nexacore-api backend. Code falls back to
# http://localhost:3000 when unset.
NEXT_PUBLIC_API_URL="http://localhost:3000"

# ─── Cloudflare Turnstile (CAPTCHA) ──────────────────────────────
# PUBLIC site key (safe to expose). The value below is Cloudflare's
# documented always-passes TEST key for local dev — replace with a real
# site key (from the Cloudflare Turnstile dashboard) for staging/prod.
NEXT_PUBLIC_TURNSTILE_SITE_KEY="1x00000000000000000000AA"

# ─── Feature flags ───────────────────────────────────────────────
# Enable the AUTH v2 intent-based login flow. Set to "true" to enable
# (any other value, or unset, keeps it disabled).
NEXT_PUBLIC_AUTH_INTENT_V2_ENABLED="false"

# ─── Test / CI only (leave unset for normal development) ─────────
# Set to "1" at BUILD time in CI to bypass auth for visual-regression
# (VRT) runs. Do NOT set in development or production.
# NEXT_PUBLIC_VRT_BYPASS_AUTH=
